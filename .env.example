# OrgSuite Workspace – Environment Template
# Copy this file to .env and fill in real values on the host only.
# NEVER commit a real .env file.

# Example placeholders (replace with real values on the deployment host)
# OPENAI_API_KEY=
# XAI_API_KEY=
# GITHUB_TOKEN=
# STRIPE_SECRET_KEY=
# DATABASE_URL=

# GoDaddy Secure Automation (server-side only)
# GODADDY_API_KEY=
# GODADDY_API_SECRET=
# GODADDY_BASE_URL=https://api.ote.godaddy.com/v1   # switch to production when ready

# GitHub OAuth App (for Command Center / connector flows – server-side only)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Create at: https://github.com/settings/developers → OAuth Apps
# Homepage: https://orgsuite-codex-command-center.vercel.app
# Callback: https://orgsuite-codex-command-center.vercel.app/api/auth/callback/github

# This file is intentionally empty of real secrets.
