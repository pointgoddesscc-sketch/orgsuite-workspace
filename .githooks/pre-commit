#!/bin/sh
# OrgSuite Workspace – pre-commit hook
# Blocks common secret patterns from being committed

echo "Running OrgSuite pre-commit checks..."

# Simple secret pattern check
if git diff --cached --name-only | xargs grep -E -i "(api[_-]?key|secret|token|password|private[_-]?key)\s*[=:]\s*['\"]?[A-Za-z0-9_\-]{16,}" 2>/dev/null; then
  echo ""
  echo "ERROR: Possible secret detected in staged files."
  echo "Remove the secret and use environment variables or a secrets manager instead."
  echo "Commit aborted."
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
