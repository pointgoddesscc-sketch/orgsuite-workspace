# OrgSuite — Meta Platform + Grok Workplace
# Copy to .env.local on the host. NEVER commit filled values.
# Status: Ready to Configure. No live Meta App or xAI key is implied by this file.

# --- Meta App (server only unless prefixed NEXT_PUBLIC_) ---
META_APP_ID=
META_APP_SECRET=
META_CLIENT_TOKEN=
META_GRAPH_VERSION=v21.0
META_PIXEL_ID=
META_CAPI_TOKEN=
META_VERIFY_TOKEN=
META_APP_PROOF_ENABLED=true

# --- Public client-safe IDs only ---
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GROK_ENABLED=false

# --- Grok / xAI (server only) ---
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
GROK_MAX_TOKENS=4096

# --- Meta AI / Llama (server only; use official Meta / approved host) ---
META_AI_API_KEY=
META_AI_MODEL=
META_AI_BASE_URL=

# --- Infra ---
DATABASE_URL=
REDIS_URL=
API_BASE_URL=
WEB_BASE_URL=

# --- Compliance ---
LEGAL_NOTICES_PATH=/legal/facebook-notices
DATA_DELETION_CALLBACK_URL=
CONSENT_REQUIRED=true
BLOCK_CHILD_ACCOUNTS=true
