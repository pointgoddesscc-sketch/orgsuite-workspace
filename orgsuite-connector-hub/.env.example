# Configure only on the host. Never commit populated environment files.
NODE_ENV=development
HUB_ORIGIN=http://127.0.0.1:4310
HUB_LISTEN_HOST=127.0.0.1
PORT=4310
HUB_OWNER_ID=
HUB_LOGIN_SECRET=
HUB_VAULT_KEY=
HUB_DATA_DIR=
# Required in production on a provisioned persistent, single-instance host.
HUB_PERSISTENT_STORAGE=
ORGSUITE_INQUIRY_INGEST_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUB_GOOGLE_ACCOUNT_EMAIL=
HUB_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
HUB_DRIVE_ROOTS=[]
GITHUB_TOKEN=
HUB_GITHUB_REPOSITORIES=["pointgoddesscc-sketch/orgsuite-workspace"]
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
HUB_VERCEL_PROJECT_IDS=[]
CLOUDFLARE_API_TOKEN=
HUB_CLOUDFLARE_ZONE_IDS=[]
