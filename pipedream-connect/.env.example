# OrgSuite Pipedream Connect — development only
# Copy to .env.local. Never commit real secrets.
# Create the OAuth client at https://pipedream.com/settings/api

PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=proj_qzsEmM9
PIPEDREAM_PROJECT_ENVIRONMENT=development
PIPEDREAM_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Stable local user id so connected accounts persist across reloads
NEXT_PUBLIC_EXTERNAL_USER_ID=orgsuite-dev-owner
NEXT_PUBLIC_PIPEDREAM_PROJECT_ENVIRONMENT=development
